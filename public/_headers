# Netlify cache rules.
# The page itself is always re-checked, so phones pick up a new upload straight away instead of an old copy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Built scripts and styles have a content hash in their name, so they can be cached for good.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
